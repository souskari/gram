// Лабораторная работа №2: PolyLang
// Простое вычисление и вывод
2x + 3y - x + 5; // Ожидаемый результат: x + 3y + 5
// Использование скобок и умножения (явного и неявного)
(x+1)*(x-1);     // Ожидаемый результат: x^2 - 1
2(x+y);         // Ожидаемый результат: 2*x + 2*y
x(y+3) - 2xy;   // Ожидаемый результат: xy + 3x - 2xy -> -xy + 3x
// Возедение в степень
(x+y)^2;         // Ожидаемый результат: x^2 + 2xy + y^2
// Унарный минус
-(x-1);          // Ожидаемый результат: -x + 1
// Присваивание переменным
LET $A = 2x^2 + 5x - 3 + @;
LET $B = x - 1;
// Использование переменных
PRINT $A;        // Вывод полинома A
PRINT $B;        // Вывод полинома B
$A + $B;        // Ожидаемый результат: 2x^2 + 6x - 4
$A * $B;        // Ожидаемый результат: (2x^2+5x-3)(x-1) = 2x^3+5x^2-3x -2x^2-5x+3 = 2x^3 + 3x^2 - 8x + 3
LET $C = $A * 2; // Умножение на константу
PRINT $C;        // Ожидаемый результат: 4x^2 + 10x - 6
// Пример с несколькими переменными
(2x+1)*(y-x);    // Ожидаемый результат: 2xy - 2x^2 + y - x
// --- Примеры Ошибок ---
// Лексическая ошибка (недопустимый символ)
// @#;
// Синтаксическая ошибка (два оператора подряд)
x ++ y;
// Синтаксическая ошибка (нет ; в конце)
LET $D = x+1
// Синтаксическая ошибка (неправильное присваивание)
LET x = 5;
// Синтаксическая ошибка (несбалансированные скобки)
(x+1;
// Семантическая ошибка (использование неопределенной переменной)
PRINT $undefinedVar;
// Семантическая ошибка (неправильная степень)
x ^ (-2);
x ^ y;

LET $F = 2 2;

PRINT 2x^2+2;
